  "vitals_rules": [
    {
      "id": "V-MULTI-ABNORMAL",
      "min_count": 3,
      "conditions": [
        [
          "rr",
          ">=",
          21
        ],
        [
          "sbp",
          "<=",
          110
        ],
        [
          "temp_c",
          ">=",
          38.1
        ],
        [
          "hr",
          ">=",
          91
        ],
        [
          "spo2",
          "<=",
          95
        ]
      ],
      "next_info": [
        "NI-OBS-REPEAT-VITALS"
      ],
      "pathway": "CP-NEWS-URGENT-REVIEW"
    }
  ],
