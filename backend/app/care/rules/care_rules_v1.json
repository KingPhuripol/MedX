{
  "version": "care-rules-1.0.0",
  "status": "MOCK baseline rules for the deterministic mock provider; written from the dev split only; not calibrated; not expert-reviewed (D1).",
  "vocabulary": {
    "next_info": {
      "NI-ECG-12LEAD": {
        "kind": "ecg",
        "display_en": "12-lead ECG",
        "display_th": "คลื่นไฟฟ้าหัวใจ 12 ลีด"
      },
      "NI-LAB-TROPONIN": {
        "kind": "lab",
        "display_en": "Cardiac troponin I",
        "display_th": "ระดับโทรโปนินไอในเลือด",
        "loinc": "10839-9"
      },
      "NI-IMG-HEAD-CT": {
        "kind": "imaging",
        "display_en": "Non-contrast head CT",
        "display_th": "ภาพเอกซเรย์คอมพิวเตอร์ศีรษะแบบไม่ฉีดสารทึบรังสี"
      },
      "NI-LAB-GLU": {
        "kind": "lab",
        "display_en": "Blood glucose",
        "display_th": "ระดับน้ำตาลในเลือด",
        "loinc": "2345-7"
      },
      "NI-ASK-LAST-KNOWN-WELL": {
        "kind": "ask",
        "display_en": "Time last known well",
        "display_th": "เวลาที่ผู้ป่วยยังปกติดีครั้งสุดท้าย"
      },
      "NI-ASK-OTTAWA-SAH": {
        "kind": "ask",
        "display_en": "Ottawa SAH rule items: age 40 or over, neck pain or stiffness, witnessed loss of consciousness, onset during exertion, instantly peaking pain, limited neck flexion",
        "display_th": "ข้อมูลตาม Ottawa SAH rule: อายุ 40 ปีขึ้นไป ปวดหรือตึงต้นคอ หมดสติโดยมีผู้เห็น เริ่มปวดขณะออกแรง ปวดสุดทันที ก้มคอได้จำกัด"
      },
      "NI-LAB-TRYPTASE": {
        "kind": "lab",
        "display_en": "Serum tryptase",
        "display_th": "ระดับทริปเทสในเลือด",
        "loinc": "21582-2"
      },
      "NI-ASK-ALLERGEN-TRIGGER": {
        "kind": "ask",
        "display_en": "Possible trigger and time of exposure (food, drug, insect sting)",
        "display_th": "สิ่งกระตุ้นที่อาจสัมผัสและเวลาที่สัมผัส (อาหาร ยา แมลงต่อย)"
      },
      "NI-LAB-LACTATE": {
        "kind": "lab",
        "display_en": "Blood lactate",
        "display_th": "ระดับแลคเตทในเลือด",
        "loinc": "2524-7"
      },
      "NI-LAB-BLOOD-CULTURE": {
        "kind": "lab",
        "display_en": "Blood culture",
        "display_th": "การเพาะเชื้อจากเลือด",
        "loinc": "600-7"
      },
      "NI-OBS-REPEAT-VITALS": {
        "kind": "observe",
        "display_en": "Repeat full set of vital signs (NEWS parameters)",
        "display_th": "วัดสัญญาณชีพซ้ำครบชุด (ตัวแปร NEWS)"
      },
      "NI-IMG-CXR": {
        "kind": "imaging",
        "display_en": "Chest radiograph",
        "display_th": "ภาพถ่ายรังสีทรวงอก"
      },
      "NI-LAB-WBC": {
        "kind": "lab",
        "display_en": "White blood cell count",
        "display_th": "จำนวนเม็ดเลือดขาว",
        "loinc": "6690-2"
      },
      "NI-LAB-CRP": {
        "kind": "lab",
        "display_en": "C-reactive protein",
        "display_th": "ระดับซีรีแอคทีฟโปรตีน",
        "loinc": "1988-5"
      },
      "NI-IMG-ABD-US": {
        "kind": "imaging",
        "display_en": "Abdominal ultrasound",
        "display_th": "อัลตราซาวด์ช่องท้อง"
      },
      "NI-LAB-HGB": {
        "kind": "lab",
        "display_en": "Hemoglobin",
        "display_th": "ระดับฮีโมโกลบิน",
        "loinc": "718-7"
      },
      "NI-LAB-CREAT": {
        "kind": "lab",
        "display_en": "Serum creatinine",
        "display_th": "ระดับครีเอตินินในเลือด",
        "loinc": "2160-0"
      },
      "NI-LAB-HBA1C": {
        "kind": "lab",
        "display_en": "Hemoglobin A1c",
        "display_th": "ระดับฮีโมโกลบินเอวันซี",
        "loinc": "4548-4"
      },
      "NI-ASK-DIARRHEA-FEATURES": {
        "kind": "ask",
        "display_en": "Fever, blood or mucus in stool, recent travel and exposures",
        "display_th": "ไข้ มูกหรือเลือดในอุจจาระ ประวัติการเดินทางและการสัมผัส"
      },
      "NI-OBS-DIX-HALLPIKE": {
        "kind": "observe",
        "display_en": "Dix-Hallpike positional test",
        "display_th": "การทดสอบท่า Dix-Hallpike"
      },
      "NI-LAB-ABSCESS-CULTURE": {
        "kind": "lab",
        "display_en": "Culture of pus from the abscess",
        "display_th": "การเพาะเชื้อจากหนองในฝี",
        "loinc": "595-9"
      },
      "NI-LAB-GAS-RADT": {
        "kind": "lab",
        "display_en": "Rapid antigen test for group A streptococcus (throat)",
        "display_th": "การตรวจแอนติเจนเชื้อสเตรปโตคอคคัสกลุ่มเอจากลำคออย่างรวดเร็ว",
        "loinc": "78012-2"
      },
      "NI-ASK-BLEEDING-RISK": {
        "kind": "ask",
        "display_en": "Bleeding history and anticoagulant or antiplatelet use",
        "display_th": "ประวัติเลือดออกง่ายและการใช้ยาต้านการแข็งตัวของเลือดหรือยาต้านเกล็ดเลือด"
      },
      "NI-OBS-ANTERIOR-RHINOSCOPY": {
        "kind": "observe",
        "display_en": "Anterior rhinoscopy to find the bleeding site",
        "display_th": "การส่องตรวจโพรงจมูกด้านหน้าเพื่อหาตำแหน่งเลือดออก"
      }
    },
    "pathways": {
      "CP-CHEST-PAIN-EVAL": {
        "display_en": "Acute chest pain evaluation pathway (AHA/ACC 2021)",
        "display_th": "แนวทางประเมินอาการเจ็บหน้าอกเฉียบพลัน (AHA/ACC 2021)"
      },
      "CP-STROKE-EVAL": {
        "display_en": "Acute stroke early evaluation pathway (AHA/ASA 2019)",
        "display_th": "แนวทางประเมินระยะแรกเมื่อสงสัยโรคหลอดเลือดสมองเฉียบพลัน (AHA/ASA 2019)"
      },
      "CP-ACUTE-HEADACHE-EVAL": {
        "display_en": "Acute headache evaluation pathway (Ottawa SAH rule)",
        "display_th": "แนวทางประเมินอาการปวดศีรษะเฉียบพลัน (Ottawa SAH rule)"
      },
      "CP-ANAPHYLAXIS-EVAL": {
        "display_en": "Anaphylaxis recognition and assessment pathway (WAO 2020)",
        "display_th": "แนวทางประเมินและเฝ้าระวังภาวะแอนาฟิแล็กซิส (WAO 2020)"
      },
      "CP-SEPSIS-SCREEN": {
        "display_en": "Sepsis screening and assessment pathway (SSC 2021)",
        "display_th": "แนวทางคัดกรองและประเมินภาวะติดเชื้อในกระแสเลือด (SSC 2021)"
      },
      "CP-NEWS-URGENT-REVIEW": {
        "display_en": "NEWS urgent clinical review pathway (RCP 2012)",
        "display_th": "แนวทางทบทวนอาการโดยเร่งด่วนตามคะแนน NEWS (RCP 2012)"
      },
      "CP-CAP-EVAL": {
        "display_en": "Community-acquired pneumonia evaluation pathway (ATS/IDSA 2019)",
        "display_th": "แนวทางประเมินเมื่อสงสัยปอดอักเสบจากชุมชน (ATS/IDSA 2019)"
      },
      "CP-RLQ-PAIN-EVAL": {
        "display_en": "Right lower quadrant pain evaluation pathway (WSES 2020)",
        "display_th": "แนวทางประเมินอาการปวดท้องด้านขวาล่าง (WSES 2020)"
      },
      "CP-ACUTE-DIARRHEA-EVAL": {
        "display_en": "Acute infectious diarrhoea evaluation pathway (IDSA 2017)",
        "display_th": "แนวทางประเมินอาการท้องเสียเฉียบพลันจากการติดเชื้อ (IDSA 2017)"
      },
      "CP-PALPITATION-EVAL": {
        "display_en": "Palpitations evaluation pathway (EHRA 2011)",
        "display_th": "แนวทางประเมินอาการใจสั่น (EHRA 2011)"
      },
      "CP-POSITIONAL-VERTIGO-EVAL": {
        "display_en": "Positional vertigo evaluation pathway (AAO-HNS 2017)",
        "display_th": "แนวทางประเมินอาการเวียนศีรษะจากการเปลี่ยนท่า (AAO-HNS 2017)"
      },
      "CP-SKIN-ABSCESS-EVAL": {
        "display_en": "Skin abscess evaluation pathway (IDSA 2014)",
        "display_th": "แนวทางประเมินฝีที่ผิวหนัง (IDSA 2014)"
      },
      "CP-EPISTAXIS-EVAL": {
        "display_en": "Nosebleed evaluation pathway (AAO-HNS 2020)",
        "display_th": "แนวทางประเมินเลือดกำเดาไหล (AAO-HNS 2020)"
      },
      "CP-PHARYNGITIS-EVAL": {
        "display_en": "Sore throat testing pathway for group A streptococcus (IDSA 2012)",
        "display_th": "แนวทางตรวจหาเชื้อสเตรปโตคอคคัสกลุ่มเอเมื่อเจ็บคอ (IDSA 2012)"
      }
    }
  },
