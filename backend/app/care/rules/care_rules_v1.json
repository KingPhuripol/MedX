      "บอกไม่ถูก",
      "ไม่ทราบ",
      "ไม่แน่ใจ",
      "จำไม่ได้"
    ],
    "duration_known_pattern": "\\d+\\s*(นาที|ชั่วโมง|วัน|สัปดาห์|เดือน|ปี)",
    "pregnancy_status_ages": [
      18,
      50
    ]
  },
