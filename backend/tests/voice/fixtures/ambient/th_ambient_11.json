  "turns": [
    {
      "turn_id": "t01",
      "speaker": "unknown",
      "text": "วันนี้มาหาหมอเรื่องอะไรคะ",
      "started_at": "2026-01-15T02:00:00Z",
      "ended_at": "2026-01-15T02:00:03Z"
    },
    {
      "turn_id": "t02",
      "speaker": "unknown",
      "text": "ไอมากค่ะ มีไข้ต่ำๆ ด้วย",
      "started_at": "2026-01-15T02:00:05Z",
      "ended_at": "2026-01-15T02:00:10Z"
    },
    {
      "turn_id": "t03",
      "speaker": "unknown",
      "text": "ไอมานานเท่าไหร่แล้วคะ",
      "started_at": "2026-01-15T02:00:12Z",
      "ended_at": "2026-01-15T02:00:15Z"
    },
    {
      "turn_id": "t04",
      "speaker": "unknown",
      "text": "ห้าวันแล้วค่ะ",
      "started_at": "2026-01-15T02:00:17Z",
      "ended_at": "2026-01-15T02:00:21Z"
    },
    {
      "turn_id": "t05",
      "speaker": "unknown",
      "text": "ไอหนักแค่ไหนคะ",
      "started_at": "2026-01-15T02:00:23Z",
      "ended_at": "2026-01-15T02:00:26Z"
    },
    {
      "turn_id": "t06",
      "speaker": "unknown",
      "text": "ปานกลางค่ะ",
      "started_at": "2026-01-15T02:00:28Z",
      "ended_at": "2026-01-15T02:00:32Z"
    },
    {
      "turn_id": "t07",
      "speaker": "unknown",
      "text": "มียาที่แพ้ไหมคะ",
      "started_at": "2026-01-15T02:00:34Z",
      "ended_at": "2026-01-15T02:00:37Z"
    },
    {
      "turn_id": "t08",
      "speaker": "unknown",
      "text": "ไม่แพ้ยาค่ะ แต่แพ้กุ้ง",
      "started_at": "2026-01-15T02:00:39Z",
      "ended_at": "2026-01-15T02:00:44Z"
    },
    {
      "turn_id": "t09",
      "speaker": "unknown",
      "text": "ตอนนี้มียาที่ทานอยู่ไหมคะ",
      "started_at": "2026-01-15T02:00:46Z",
      "ended_at": "2026-01-15T02:00:49Z"
    },
    {
      "turn_id": "t10",
      "speaker": "unknown",
      "text": "กินพารากับยาแก้ไอน้ำดำค่ะ",
      "started_at": "2026-01-15T02:00:51Z",
      "ended_at": "2026-01-15T02:00:56Z"
    },
    {
      "turn_id": "t11",
      "speaker": "unknown",
      "text": "มีโรคประจำตัวอะไรหรือเปล่าคะ",
      "started_at": "2026-01-15T02:00:58Z",
      "ended_at": "2026-01-15T02:01:01Z"
    },
    {
      "turn_id": "t12",
      "speaker": "unknown",
      "text": "ไม่มีค่ะ แข็งแรงดี",
      "started_at": "2026-01-15T02:01:03Z",
      "ended_at": "2026-01-15T02:01:08Z"
