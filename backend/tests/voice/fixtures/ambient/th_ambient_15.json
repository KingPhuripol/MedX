    },
    {
      "turn_id": "t09",
      "speaker": "unknown",
      "text": "ใช้ยาตัวไหนประจำบ้างคะ",
      "started_at": "2026-01-19T02:00:48Z",
      "ended_at": "2026-01-19T02:00:51Z"
    },
    {
      "turn_id": "t10",
      "speaker": "unknown",
      "text": "เดี๋ยวให้ลูกมาบอกครับ",
      "started_at": "2026-01-19T02:00:53Z",
      "ended_at": "2026-01-19T02:00:58Z"
    },
    {
      "turn_id": "t11",
      "speaker": "unknown",
      "text": "ตกลงตอนนี้ทานยาอะไรอยู่คะ",
