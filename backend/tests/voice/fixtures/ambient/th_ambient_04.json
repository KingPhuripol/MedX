    },
    {
      "turn_id": "t02",
      "speaker": "unknown",
      "text": "ปวดหัวครับ ปวดตุ้บๆ ที่ขมับ",
      "started_at": "2026-01-08T02:00:05Z",
      "ended_at": "2026-01-08T02:00:10Z"
    },
    {
      "turn_id": "t03",
      "speaker": "unknown",
      "text": "เป็นมากี่วันแล้วคะ",
      "started_at": "2026-01-08T02:00:12Z",
      "ended_at": "2026-01-08T02:00:15Z"
    },
    {
      "turn_id": "t04",
      "speaker": "unknown",
      "text": "ปวดมาสามวันแล้วครับ",
      "started_at": "2026-01-08T02:00:17Z",
      "ended_at": "2026-01-08T02:00:22Z"
    },
    {
      "turn_id": "t05",
      "speaker": "unknown",
      "text": "ปวดกี่คะแนนคะ",
      "started_at": "2026-01-08T02:00:24Z",
      "ended_at": "2026-01-08T02:00:27Z"
    },
    {
      "turn_id": "t06",
      "speaker": "unknown",
      "text": "เอ๊ะ เดี๋ยวครับ ไม่ใช่สามวัน สี่วันแล้วครับ นับผิด ส่วนความปวดให้ 8 เต็ม 10",
      "started_at": "2026-01-08T02:00:29Z",
      "ended_at": "2026-01-08T02:00:38Z"
    },
    {
      "turn_id": "t07",
      "speaker": "unknown",
      "text": "แพ้ยาอะไรไหมคะ",
      "started_at": "2026-01-08T02:00:40Z",
      "ended_at": "2026-01-08T02:00:43Z"
    },
    {
      "turn_id": "t08",
      "speaker": "unknown",
      "text": "เรื่องนี้ไม่ขอตอบครับ",
      "started_at": "2026-01-08T02:00:45Z",
      "ended_at": "2026-01-08T02:00:50Z"
    },
    {
      "turn_id": "t09",
      "speaker": "unknown",
      "text": "ทานยาอะไรประจำไหมคะ",
      "started_at": "2026-01-08T02:00:52Z",
      "ended_at": "2026-01-08T02:00:55Z"
    },
    {
      "turn_id": "t10",
      "speaker": "unknown",
      "text": "กินพาราเซตามอลครับ",
      "started_at": "2026-01-08T02:00:57Z",
      "ended_at": "2026-01-08T02:01:02Z"
    },
    {
      "turn_id": "t11",
      "speaker": "unknown",
      "text": "มีโรคประจำตัวไหมคะ",
      "started_at": "2026-01-08T02:01:04Z",
      "ended_at": "2026-01-08T02:01:07Z"
    },
