    },
    {
      "turn_id": "t02",
      "speaker": "unknown",
      "text": "พ่ออาเจียนค่ะ กินอะไรไม่ได้เลย",
      "started_at": "2026-01-18T02:00:05Z",
      "ended_at": "2026-01-18T02:00:11Z"
    },
    {
      "turn_id": "t03",
      "speaker": "unknown",
      "text": "อาเจียนมากี่วันแล้วคะ",
      "started_at": "2026-01-18T02:00:13Z",
      "ended_at": "2026-01-18T02:00:16Z"
    },
    {
      "turn_id": "t04",
      "speaker": "unknown",
      "text": "อาเจียนมา 2 วันค่ะ",
      "started_at": "2026-01-18T02:00:18Z",
      "ended_at": "2026-01-18T02:00:23Z"
    },
    {
      "turn_id": "t05",
      "speaker": "unknown",
      "text": "อาการหนักไหมคะ",
      "started_at": "2026-01-18T02:00:25Z",
      "ended_at": "2026-01-18T02:00:28Z"
    },
    {
      "turn_id": "t06",
      "speaker": "unknown",
      "text": "อ้อ ขอโทษค่ะ ไม่ใช่ 2 วัน สามวันแล้วค่ะ อาการหนักมาก",
      "started_at": "2026-01-18T02:00:30Z",
      "ended_at": "2026-01-18T02:00:37Z"
    },
    {
      "turn_id": "t07",
      "speaker": "unknown",
      "text": "คุณพ่อมีประวัติแพ้ยาหรือเปล่าคะ",
      "started_at": "2026-01-18T02:00:39Z",
      "ended_at": "2026-01-18T02:00:42Z"
    },
    {
      "turn_id": "t08",
      "speaker": "unknown",
      "text": "พ่อไม่อยากบอกค่ะ",
      "started_at": "2026-01-18T02:00:44Z",
      "ended_at": "2026-01-18T02:00:49Z"
    },
    {
      "turn_id": "t09",
      "speaker": "unknown",
      "text": "คุณพ่อทานยาอะไรอยู่บ้างคะ",
      "started_at": "2026-01-18T02:00:51Z",
      "ended_at": "2026-01-18T02:00:54Z"
    },
    {
      "turn_id": "t10",
      "speaker": "unknown",
      "text": "กิน metformin กับ losartan ค่ะ",
      "started_at": "2026-01-18T02:00:56Z",
      "ended_at": "2026-01-18T02:01:02Z"
    },
    {
      "turn_id": "t11",
      "speaker": "unknown",
      "text": "คุณพ่อมีโรคประจำตัวอะไรบ้างคะ",
      "started_at": "2026-01-18T02:01:04Z",
      "ended_at": "2026-01-18T02:01:07Z"
    },
    {
