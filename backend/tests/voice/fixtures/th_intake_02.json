      "text": "มีอาการนี้มานานเท่าไรแล้วคะ",
      "started_at": "2026-01-06T02:00:12Z",
      "ended_at": "2026-01-06T02:00:15Z"
    },
    {
      "turn_id": "t04",
      "speaker": "patient",
      "text": "สองวันแล้วค่ะ",
      "started_at": "2026-01-06T02:00:17Z",
      "ended_at": "2026-01-06T02:00:21Z"
    },
    {
      "turn_id": "t05",
      "speaker": "agent",
      "text": "ถ้าให้คะแนนความรุนแรง 0 ถึง 10 ตอนนี้ประมาณเท่าไรคะ",
      "started_at": "2026-01-06T02:00:23Z",
      "ended_at": "2026-01-06T02:00:26Z"
    },
    {
      "turn_id": "t06",
