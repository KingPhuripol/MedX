{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/human-approval.schema.json",
  "title": "Human Approval Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "approvals"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "approvals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["approval_id", "type", "requester", "approver", "requested_at", "decided_at", "expires_at", "scope", "rationale", "risks", "safeguards", "limits", "rollback", "decision", "linked_records", "result"],
        "properties": {
          "approval_id": {"type": "string", "pattern": "^APR-[0-9]{4}$"},
          "type": {"enum": ["COMPUTE", "DATA_TRANSFER", "DESTRUCTIVE_CHANGE", "PUBLICATION", "DEPLOYMENT", "SCOPE_CHANGE", "DEADLINE_CORRECTION", "SAFETY_RISK", "CLINICAL_USE"]},
          "requester": {"type": "string", "minLength": 3},
          "approver": {"type": "string", "minLength": 3},
          "requested_at": {"type": "string", "format": "date-time"},
          "decided_at": {"type": ["string", "null"], "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "scope": {"type": "string", "minLength": 10},
          "rationale": {"type": "string", "minLength": 10},
          "risks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "safeguards": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "limits": {"type": "object"},
          "rollback": {"type": "string", "minLength": 10},
          "decision": {"enum": ["PENDING", "APPROVED", "DENIED", "EXPIRED", "REVOKED"]},
          "linked_records": {"type": "array", "items": {"type": "string"}},
          "result": {"type": ["string", "null"]}
        }
      }
    }
  }
}
