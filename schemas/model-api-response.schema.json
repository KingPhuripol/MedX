{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/model-api-response.schema.json",
  "title": "Model Gateway Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "response_id", "provider", "model_version", "status", "urgency", "red_flags", "care_pathways", "next_information", "uncertainty", "human_review", "graph", "provenance", "errors"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 6},
    "response_id": {"type": "string", "minLength": 6},
    "provider": {"enum": ["mock", "external_prototype", "baseline", "team_model"]},
    "model_version": {"type": "string", "minLength": 2},
    "status": {"enum": ["COMPLETED", "ABSTAINED", "ESCALATED", "FAILED_SAFE"]},
    "urgency": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "confidence", "evidence_ids"],
      "properties": {
        "level": {"enum": ["IMMEDIATE_REVIEW", "URGENT_REVIEW", "ROUTINE_REVIEW", "INSUFFICIENT_INFORMATION"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "state", "evidence_ids"],
        "properties": {
          "code": {"type": "string", "minLength": 2},
          "state": {"enum": ["TRIGGERED", "NOT_TRIGGERED", "UNKNOWN"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "care_pathways": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "rank", "confidence", "evidence_ids"],
        "properties": {
          "code": {"type": "string", "minLength": 2},
          "rank": {"type": "integer", "minimum": 1},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "next_information": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["information_type", "rank", "reason_code"],
        "properties": {
          "information_type": {"type": "string", "minLength": 2},
          "rank": {"type": "integer", "minimum": 1},
          "reason_code": {"type": "string", "minLength": 2}
        }
      }
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "limitations", "out_of_distribution", "abstention_reason"],
      "properties": {
        "method": {"type": "string", "minLength": 2},
        "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "out_of_distribution": {"type": ["boolean", "null"]},
        "abstention_reason": {"type": ["string", "null"]}
      }
    },
    "human_review": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "allowed_actions"],
      "properties": {
        "required": {"const": true},
        "allowed_actions": {"type": "array", "items": {"enum": ["CONFIRM", "MODIFY", "REJECT", "REQUEST_INFORMATION", "ESCALATE"]}, "minItems": 1, "uniqueItems": true}
      }
    },
    "graph": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "graph_schema_version": {"type": "string", "minLength": 1},
        "graph_id": {"type": "string", "minLength": 3},
        "graph_ref": {"type": "string", "minLength": 3}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["input_checksum", "provider_version", "config_version", "policy_version", "started_at", "completed_at"],
      "properties": {
        "input_checksum": {"type": "string", "minLength": 8},
        "provider_version": {"type": "string", "minLength": 1},
        "config_version": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {"enum": ["INVALID_REQUEST", "TEMPORAL_VIOLATION", "UNAUTHORIZED_DATA", "UNSUPPORTED_MODALITY", "PROVIDER_TIMEOUT", "INVALID_PROVIDER_OUTPUT", "BUDGET_EXCEEDED", "LOW_CONFIDENCE", "INTERNAL_SAFE_FAILURE"]},
          "message": {"type": "string", "minLength": 3},
          "retryable": {"type": "boolean"}
        }
      }
    }
  }
}

