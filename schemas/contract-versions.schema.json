{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/contract-versions.schema.json",
  "title": "Shared contract version registry",
  "description": "Single machine-readable registry of the versions of the five shared contracts. G0 requires these contracts to be accepted and versioned before any research or product claim depends on them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "contracts"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated_at": { "type": "string" },
    "contracts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "title", "document", "version", "owner", "status", "accepted_on", "machine_schemas", "updated_at"],
        "properties": {
          "contract_id": { "type": "string", "pattern": "^CONTRACT-[0-9]{4}$" },
          "title": { "type": "string" },
          "document": { "type": "string" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "owner": { "type": "string" },
          "reviewer": { "type": ["string", "null"] },
          "status": { "enum": ["DRAFT", "ACCEPTED", "SUPERSEDED"] },
          "accepted_on": { "type": "string" },
          "machine_schemas": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": ["string", "null"] },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
