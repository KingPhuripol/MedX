{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/decision.schema.json",
  "title": "Decision Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decision_id", "date", "title", "status", "owner", "context", "decision", "rationale", "alternatives", "consequences", "supersedes", "evidence", "approvers"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^DEC-[0-9]{4}$"},
          "date": {"type": "string", "format": "date"},
          "title": {"type": "string", "minLength": 5},
          "status": {"enum": ["proposed", "accepted", "rejected", "superseded"]},
          "owner": {"type": "string", "minLength": 3},
          "context": {"type": "string", "minLength": 10},
          "decision": {"type": "string", "minLength": 10},
          "rationale": {"type": "string", "minLength": 10},
          "alternatives": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "consequences": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "supersedes": {"type": ["string", "null"], "pattern": "^DEC-[0-9]{4}$"},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "approvers": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    }
  }
}

