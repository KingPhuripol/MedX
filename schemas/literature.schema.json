{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/literature.schema.json",
  "title": "Literature, novelty and baseline feasibility registry",
  "description": "The single citation contract for the project. TASK-0004 requires a documented search protocol, a novelty matrix and a baseline shortlist; this registry holds all three as data. A reference here is a verified citation, never a citation written from memory: ACCEPTED requires a primary-source verification method and date. Rejected records are retained deliberately, because the excluded-candidate list is part of the deliverable. Recording a reference is not selecting a baseline, adopting a clinical standard, or choosing a base model: those need human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "searches", "references", "baseline_families"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated_at": { "type": "string" },

    "searches": {
      "type": "array",
      "description": "The search protocol as data. One record per literature search, so the survey is reproducible rather than narrated.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "search_id", "question", "coverage_areas", "protocol_status", "queries",
          "sources_consulted", "date_window_from", "date_window_to",
          "inclusion_criteria", "exclusion_criteria", "run_on", "executed_by",
          "candidates_screened", "yielded", "updated_at"
        ],
        "properties": {
          "search_id": { "type": "string", "pattern": "^SRCH-[0-9]{4}$" },
          "question": { "type": "string", "minLength": 20, "description": "The exact question asked, recorded verbatim before the search runs so it cannot be paraphrased to fit the answer." },
          "coverage_areas": {
            "type": "array",
            "minItems": 1,
            "description": "TASK-0004's definition of done names four coverage areas verbatim; the harness asserts each carries at least one ACCEPTED reference. benchmark_feasibility serves DoD clause 2.",
            "items": { "enum": ["medical_multimodal", "dynamic_sparse_computation", "graph_faithfulness", "clinical_front_door", "benchmark_feasibility"] }
          },
          "novelty_axes": { "type": "array", "items": { "enum": ["medical_multimodal_breadth", "longitudinal_3d", "conditional_sparse_computation", "dynamic_graph_topology", "typed_operators", "graph_export_replay_intervention", "case_level_adaptation", "equal_compute_evidence", "clinical_front_door_use"] } },
          "protocol_status": {
            "enum": ["RECORDED", "RECONSTRUCTED"],
            "description": "RECORDED means the queries were written down as the search ran. RECONSTRUCTED means the round predates this registry and only its policy survives; such a record may not claim queries it does not have."
          },
          "queries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "sources_consulted": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["crossref", "arxiv", "pubmed", "semantic_scholar", "openreview", "proceedings_site", "publisher_site", "dataset_card", "model_card", "official_docs", "web_search", "other"] }
          },
          "date_window_from": { "type": "string", "format": "date" },
          "date_window_to": { "type": "string", "format": "date" },
          "inclusion_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "exclusion_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "run_on": { "type": "string", "format": "date" },
          "executed_by": { "type": "string", "minLength": 3 },
          "candidates_screened": { "type": "integer", "minimum": 0 },
          "yielded": { "type": "array", "items": { "type": "string", "pattern": "^LIT-[0-9]{4}$" } },
          "report_ref": { "type": ["string", "null"], "description": "Repository path of the archived scout report, so the protocol is auditable after the fact." },
          "notes": { "type": ["string", "null"] },
          "updated_at": { "type": "string" }
        }
      }
    },

    "references": {
      "type": "array",
      "description": "The citation store. Every external factual claim in any project document resolves to a reference_id here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id", "found_by", "role", "coverage_areas", "venue_type",
          "citation", "identifiers", "verification", "novelty",
          "verdict", "evidence", "reviewed_by", "reviewed_on", "updated_at"
        ],
        "properties": {
          "reference_id": { "type": "string", "pattern": "^LIT-[0-9]{4}$" },
          "found_by": { "type": "string", "pattern": "^SRCH-[0-9]{4}$" },
          "role": {
            "enum": ["related_work", "baseline_candidate", "benchmark_or_dataset", "method_precedent", "evaluation_methodology", "clinical_standard", "safety_evidence", "license_or_governance"],
            "description": "What this reference does for the project. baseline_candidate is the only role that may carry a comparison block."
          },
          "coverage_areas": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["medical_multimodal", "dynamic_sparse_computation", "graph_faithfulness", "clinical_front_door", "benchmark_feasibility"] }
          },
          "venue_type": { "enum": ["peer_reviewed_journal", "conference_proceedings", "preprint", "dataset_card", "model_card", "standard_or_guideline", "official_documentation", "other"] },

          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authors", "year", "title", "apa7"],
            "properties": {
              "authors": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Every author as printed. Never 'et al.' — an abbreviated list cannot be checked against the source." },
              "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
              "title": { "type": "string", "minLength": 5 },
              "container": { "type": ["string", "null"] },
              "volume": { "type": ["string", "null"] },
              "issue": { "type": ["string", "null"] },
              "pages": { "type": ["string", "null"] },
              "article_number": { "type": ["string", "null"] },
              "publisher": { "type": ["string", "null"] },
              "apa7": { "type": "string", "minLength": 20, "description": "The single formatted string every project document reuses. Reference lists are generated from this field, never retyped." }
            }
          },

          "identifiers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["doi", "arxiv_id", "pmid", "url"],
            "properties": {
              "doi": { "type": ["string", "null"] },
              "arxiv_id": { "type": ["string", "null"] },
              "pmid": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] }
            }
          },

          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "verified_on", "verified_fields", "status"],
            "properties": {
              "method": { "enum": ["crossref_rest", "doi_content_negotiation", "arxiv_api", "pubmed_eutils", "publisher_page", "official_site", "dataset_card", "license_page", "not_verified"] },
              "verified_on": { "type": ["string", "null"], "format": "date" },
              "verified_fields": { "type": "array", "items": { "enum": ["title", "authors", "year", "container", "volume", "issue", "pages", "article_number", "doi", "license", "version"] } },
              "status": { "enum": ["VERIFIED", "UNVERIFIED", "CONFLICT"] },
              "conflict_note": { "type": ["string", "null"], "description": "Required when status is CONFLICT. A CONFLICT record may never be ACCEPTED." },
              "notes": { "type": ["string", "null"] }
            }
          },

          "quoted_figures": {
            "type": "array",
            "description": "Every number quoted from this work, with where it was read. A figure not recorded here may not be quoted in a project document.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["figure", "location", "read_on"],
              "properties": {
                "figure": { "type": "string", "minLength": 3 },
                "location": { "type": "string", "minLength": 3 },
                "read_on": { "type": "string", "format": "date" }
              }
            }
          },

          "novelty": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axes", "positions"],
            "properties": {
              "axes": { "type": "array", "items": { "enum": ["medical_multimodal_breadth", "longitudinal_3d", "conditional_sparse_computation", "dynamic_graph_topology", "typed_operators", "graph_export_replay_intervention", "case_level_adaptation", "equal_compute_evidence", "clinical_front_door_use"] } },
              "positions": {
                "type": "array",
                "description": "This system's row in the novelty matrix. NOT_REPORTED is the honest cell for an axis the work does not discuss; ABSENT requires the source to show the capability is missing.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["axis", "cell", "basis"],
                  "properties": {
                    "axis": { "enum": ["medical_multimodal_breadth", "longitudinal_3d", "conditional_sparse_computation", "dynamic_graph_topology", "typed_operators", "graph_export_replay_intervention", "case_level_adaptation", "equal_compute_evidence", "clinical_front_door_use"] },
                    "cell": { "enum": ["DEMONSTRATED", "PARTIAL", "ABSENT", "NOT_REPORTED"] },
                    "basis": { "type": "string", "minLength": 10, "description": "Where in the source this cell was read." }
                  }
                }
              }
            }
          },

          "comparison": {
            "type": ["object", "null"],
            "description": "Non-null only when role is baseline_candidate. BENCHMARK_CONTRACT.md forbids relying on a proprietary baseline whose evaluation cannot be reproduced.",
            "additionalProperties": false,
            "required": ["family", "modalities", "weights_available", "code_available", "license", "reproducible_evaluation", "equal_compute_feasible"],
            "properties": {
              "family": { "enum": ["fixed_path_medical_open", "same_backbone_fixed_path", "static_typed_dag", "random_or_shuffled_router", "sparse_moe_routing", "proposed_dynamic_typed_dag"] },
              "scale": { "type": ["string", "null"], "description": "Parameter count as reported by the source, not inferred." },
              "modalities": { "type": "array", "items": { "enum": ["clinical_text", "image_2d", "volume_3d", "structured", "longitudinal"] } },
              "weights_available": { "enum": ["YES", "NO", "GATED", "UNKNOWN"] },
              "code_available": { "enum": ["YES", "NO", "PARTIAL", "UNKNOWN"] },
              "license": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "status"],
                "properties": {
                  "name": { "type": "string" },
                  "url": { "type": ["string", "null"] },
                  "status": { "enum": ["VERIFIED", "UNVERIFIED"] },
                  "beyond_dec_0011_ceiling": { "enum": ["YES", "NO", "UNKNOWN"], "description": "Whether this licence constrains the release further than the non-commercial research-use ceiling already accepted in DEC-0011." },
                  "notes": { "type": ["string", "null"] }
                }
              },
              "reproducible_evaluation": { "enum": ["YES", "NO", "PARTIAL", "UNKNOWN"] },
              "equal_compute_feasible": { "enum": ["YES", "NO", "CONDITIONAL", "UNKNOWN"] },
              "fit_notes": { "type": ["string", "null"] }
            }
          },

          "supports_claims": { "type": "array", "items": { "type": "string", "pattern": "^C-[0-9]{2}[a-z]?$" }, "description": "Claim IDs from docs/academic/PROJECT_IDEA_CLAIMS.md that this reference backs." },
          "supports_rqs": { "type": "array", "items": { "enum": ["RQ1", "RQ2", "RQ3", "RQ4", "RQ5"] } },
          "cited_in": { "type": "array", "items": { "type": "string" }, "description": "Repository-relative paths of documents that use this reference." },
          "related_datasets": { "type": "array", "items": { "type": "string", "pattern": "^DS-[0-9]{4}$" }, "description": "Cross-link into project_state/dataset_feasibility.json. A dataset named here must already be under survey." },

          "verdict": {
            "enum": ["UNDER_REVIEW", "ACCEPTED", "CONDITIONAL", "REJECTED"],
            "description": "ACCEPTED means verified against a primary source and cleared for citation. CONDITIONAL names an unmet condition. REJECTED records are retained: the excluded-candidate list is part of the deliverable."
          },
          "verdict_rationale": { "type": ["string", "null"] },
          "excluded_reason": { "type": ["string", "null"], "description": "Required when verdict is REJECTED." },
          "evidence": { "type": "array", "description": "Where each recorded fact was read. An empty array is only valid while verdict is UNDER_REVIEW.", "items": { "type": "string" } },
          "blocking_risks": { "type": "array", "items": { "type": "string", "pattern": "^RISK-[0-9]{4}$" } },
          "linked_tasks": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
          "reviewed_by": { "type": ["string", "null"] },
          "reviewed_on": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },

    "baseline_families": {
      "type": "array",
      "description": "One record for each of the six comparison families required by docs/research/BENCHMARK_CONTRACT.md. All six must be present; NO_VALID_CANDIDATE is a recorded outcome, not a gap.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "resolution", "selected_reference", "considered", "rationale", "fallback_plan", "reviewed_by", "updated_at"],
        "properties": {
          "family": { "enum": ["fixed_path_medical_open", "same_backbone_fixed_path", "static_typed_dag", "random_or_shuffled_router", "sparse_moe_routing", "proposed_dynamic_typed_dag"] },
          "resolution": {
            "enum": ["CANDIDATE_SELECTED", "CANDIDATE_CONDITIONAL", "NO_VALID_CANDIDATE", "INTERNAL_CONTROL", "DEFERRED"],
            "description": "INTERNAL_CONTROL means the project builds this arm rather than downloading it; what is owed there is a method precedent, not a checkpoint."
          },
          "selected_reference": { "type": ["string", "null"], "pattern": "^LIT-[0-9]{4}$" },
          "considered": { "type": "array", "items": { "type": "string", "pattern": "^LIT-[0-9]{4}$" } },
          "rationale": { "type": "string", "minLength": 20 },
          "fallback_plan": { "type": "string", "minLength": 10 },
          "blocking_risks": { "type": "array", "items": { "type": "string", "pattern": "^RISK-[0-9]{4}$" } },
          "reviewed_by": { "type": ["string", "null"] },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
