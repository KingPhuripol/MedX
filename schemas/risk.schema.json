{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/risk.schema.json",
  "title": "Risk Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "risks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "risks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["risk_id", "description", "probability", "impact", "owner", "trigger", "mitigation", "fallback", "review_date", "status", "linked_tasks", "updated_at"],
        "properties": {
          "risk_id": {"type": "string", "pattern": "^RISK-[0-9]{4}$"},
          "description": {"type": "string", "minLength": 10},
          "probability": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "impact": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "owner": {"type": "string", "minLength": 3},
          "trigger": {"type": "string", "minLength": 5},
          "mitigation": {"type": "string", "minLength": 10},
          "fallback": {"type": "string", "minLength": 10},
          "review_date": {"type": "string", "format": "date"},
          "status": {"enum": ["OPEN", "MONITORING", "MITIGATED", "REALIZED", "CLOSED"]},
          "linked_tasks": {"type": "array", "items": {"type": "string", "pattern": "^TASK-[0-9]{4}$"}, "uniqueItems": true},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}

