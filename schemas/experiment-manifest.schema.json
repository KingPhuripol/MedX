{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/experiment-manifest.schema.json",
  "title": "Experiment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "slug", "owner", "task_id", "research_question",
    "hypothesis", "decision_informed", "status", "run_tier", "created_at", "code",
    "model", "data", "training", "graph", "resources", "comparisons", "evaluation",
    "stop_rules", "artifacts", "approvals", "risks"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "pattern": "^exp_[0-9]{4}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "owner": {"type": "string", "minLength": 3},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "parent_experiment_id": {"type": ["string", "null"], "pattern": "^exp_[0-9]{4}$"},
    "research_question": {"type": "string", "minLength": 20},
    "hypothesis": {"type": "string", "minLength": 20},
    "decision_informed": {"type": "string", "minLength": 10},
    "status": {"enum": ["planned", "approved", "running", "completed", "failed", "stopped", "invalidated"]},
    "run_tier": {"type": "integer", "minimum": 0, "maximum": 4},
    "created_at": {"type": "string", "format": "date-time"},
    "code": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "dirty", "diff_artifact", "config_hash"],
      "properties": {
        "revision": {"type": "string", "minLength": 4},
        "dirty": {"type": "boolean"},
        "diff_artifact": {"type": ["string", "null"]},
        "config_hash": {"type": "string", "minLength": 8}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "parameter_count", "initialization", "license"],
      "properties": {
        "name": {"type": "string", "minLength": 2},
        "version": {"type": "string", "minLength": 1},
        "parameter_count": {"type": "integer", "minimum": 1},
        "initialization": {"type": "string", "minLength": 2},
        "license": {"type": "string", "minLength": 2}
      }
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_version", "split_version", "split_checksum", "preprocessing_version", "temporal_audit_id", "classification", "license_status"],
      "properties": {
        "dataset_version": {"type": "string", "minLength": 2},
        "split_version": {"type": "string", "minLength": 2},
        "split_checksum": {"type": "string", "minLength": 8},
        "preprocessing_version": {"type": "string", "minLength": 2},
        "temporal_audit_id": {"type": "string", "minLength": 2},
        "classification": {"enum": ["SYNTHETIC", "PUBLIC_LICENSED", "DEIDENTIFIED_APPROVED", "IDENTIFIABLE_OR_LINKABLE", "RESTRICTED_DERIVATIVE"]},
        "license_status": {"enum": ["cleared", "restricted", "unresolved"]}
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "precision", "optimizer", "scheduler", "max_steps", "max_tokens", "batch_size", "gradient_accumulation", "checkpoint_policy"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "precision": {"enum": ["fp32", "fp16", "bf16", "mixed", "not_applicable"]},
        "optimizer": {"type": "string", "minLength": 2},
        "scheduler": {"type": "string", "minLength": 2},
        "max_steps": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "gradient_accumulation": {"type": "integer", "minimum": 1},
        "checkpoint_policy": {"type": "string", "minLength": 5}
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "schema_version", "operator_library_version", "max_nodes", "max_depth", "routing_objectives"],
      "properties": {
        "mode": {"enum": ["fixed", "static", "soft", "sparse", "discrete", "random", "not_applicable"]},
        "schema_version": {"type": "string", "minLength": 1},
        "operator_library_version": {"type": "string", "minLength": 1},
        "max_nodes": {"type": "integer", "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0},
        "routing_objectives": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["devices", "gpu_count", "estimated_minutes", "estimated_gpu_hours", "estimated_cost_usd", "estimated_storage_gb"],
      "properties": {
        "devices": {"type": "string", "minLength": 2},
        "gpu_count": {"type": "integer", "minimum": 0},
        "estimated_minutes": {"type": "integer", "minimum": 0},
        "estimated_gpu_hours": {"type": "number", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "estimated_storage_gb": {"type": "number", "minimum": 0}
      }
    },
    "comparisons": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_experiment_ids", "fixed_factors", "changed_factors", "fairness_notes"],
      "properties": {
        "baseline_experiment_ids": {"type": "array", "items": {"type": "string", "pattern": "^exp_[0-9]{4}$"}, "uniqueItems": true},
        "fixed_factors": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "changed_factors": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "fairness_notes": {"type": "string", "minLength": 10}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluator_version", "primary_metrics", "secondary_metrics", "statistics_plan", "exclusion_rules", "final_test_access"],
      "properties": {
        "evaluator_version": {"type": "string", "minLength": 2},
        "primary_metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "secondary_metrics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "statistics_plan": {"type": "string", "minLength": 10},
        "exclusion_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "final_test_access": {"enum": ["none", "sealed", "authorized_once", "not_applicable"]}
      }
    },
    "stop_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "logs", "checkpoints", "predictions", "evaluation_record", "retention"],
      "properties": {
        "root": {"type": "string", "minLength": 3},
        "logs": {"type": "string", "minLength": 3},
        "checkpoints": {"type": "string", "minLength": 3},
        "predictions": {"type": "string", "minLength": 3},
        "evaluation_record": {"type": "string", "minLength": 3},
        "retention": {"type": "string", "minLength": 5}
      }
    },
    "approvals": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "approval_ids"],
      "properties": {
        "required": {"type": "boolean"},
        "approval_ids": {"type": "array", "items": {"type": "string", "pattern": "^APR-[0-9]{4}$"}, "uniqueItems": true}
      }
    },
    "risks": {"type": "array", "items": {"type": "string", "pattern": "^RISK-[0-9]{4}$"}, "uniqueItems": true},
    "result": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  }
}

