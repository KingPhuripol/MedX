{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/official-deadlines.schema.json",
  "title": "Immutable Official Deadline Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_document", "source_file_present", "transcription_status", "timezone", "immutable", "deadlines"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_document": {"const": "Senior_Project 2026_sem1_activities.pdf"},
    "source_file_present": {"type": "boolean"},
    "transcription_status": {"enum": ["PENDING_VISUAL_VERIFICATION", "VISUALLY_VERIFIED"]},
    "timezone": {"const": "Asia/Bangkok"},
    "immutable": {"const": true},
    "deadlines": {
      "type": "array", "minItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["deadline_id", "name", "official_date_start", "official_date_end", "official_time", "planning_deadline", "condition", "requirements", "status"],
        "properties": {
          "deadline_id": {"type": "string", "pattern": "^DL-[0-9]{4}$"},
          "name": {"type": "string", "minLength": 3},
          "official_date_start": {"type": "string", "format": "date"},
          "official_date_end": {"type": "string", "format": "date"},
          "official_time": {"type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
          "planning_deadline": {"type": "string", "format": "date-time"},
          "condition": {"type": ["string", "null"]},
          "requirements": {"type": "string", "minLength": 3},
          "status": {"enum": ["NEEDS_CONFIRMATION", "NOT_STARTED", "IN_PROGRESS", "SUBMITTED", "COMPLETE"]}
        }
      }
    }
  }
}
