{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/patient-journey.schema.json",
  "title": "Patient Journey",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journey_id", "patient_id", "encounter_id", "split", "data_classification", "source", "encounter_start", "events"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "journey_id": {"type": "string", "minLength": 4},
    "patient_id": {"type": "string", "minLength": 4},
    "encounter_id": {"type": "string", "minLength": 4},
    "split": {"enum": ["train", "validation", "internal_test", "external_test", "expert_test", "architecture_intervention", "missing_modality_test", "unseen_combination_test"]},
    "data_classification": {"enum": ["SYNTHETIC", "PUBLIC_LICENSED", "DEIDENTIFIED_APPROVED", "IDENTIFIABLE_OR_LINKABLE", "RESTRICTED_DERIVATIVE"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "version"],
      "properties": {
        "system": {"type": "string", "minLength": 2},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "encounter_start": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "event_type", "modality", "observed_at", "available_at_time", "status", "data_classification", "source_ref"],
        "properties": {
          "event_id": {"type": "string", "minLength": 3},
          "event_type": {"enum": ["CHIEF_COMPLAINT", "TRIAGE_NOTE", "DEMOGRAPHICS", "HISTORY", "MEDICATION", "ALLERGY", "VITAL", "EXAM", "LAB", "ECG", "IMAGE_2D", "IMAGE_3D", "REPORT", "CONSULT", "DIAGNOSIS", "DISPOSITION", "OUTCOME", "MISSINGNESS"]},
          "modality": {"enum": ["TEXT", "STRUCTURED", "IMAGE_2D", "IMAGE_3D", "SIGNAL", "LABEL", "REFERENCE"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "available_at_time": {"type": "string", "format": "date-time"},
          "recorded_at": {"type": ["string", "null"], "format": "date-time"},
          "status": {"enum": ["AVAILABLE", "NOT_MEASURED", "MEASURED_UNKNOWN", "NOT_AVAILABLE_YET", "WITHHELD", "UNSUPPORTED", "CORRUPT", "NOT_APPLICABLE"]},
          "data_classification": {"enum": ["SYNTHETIC", "PUBLIC_LICENSED", "DEIDENTIFIED_APPROVED", "IDENTIFIABLE_OR_LINKABLE", "RESTRICTED_DERIVATIVE"]},
          "source_ref": {
            "type": "object", "additionalProperties": false,
            "required": ["system", "version", "record_ref"],
            "properties": {
              "system": {"type": "string", "minLength": 2},
              "version": {"type": "string", "minLength": 1},
              "record_ref": {"type": "string", "minLength": 2}
            }
          },
          "payload_ref": {"type": ["string", "null"]},
          "checksum": {"type": ["string", "null"]},
          "value": {},
          "code": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "authorization_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}

