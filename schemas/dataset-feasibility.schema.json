{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/dataset-feasibility.schema.json",
  "title": "Dataset access, license and ethics feasibility inventory",
  "description": "Records the documentary feasibility survey a dataset must pass before it may be selected. G0 requires a recorded dataset access/license/ethics feasibility inventory; BENCHMARK_CONTRACT.md forbids naming a dataset as selected before access and license evidence exists. A record here is a survey result, not an authorization to download or process data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "datasets"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated_at": { "type": "string" },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id", "name", "owner", "verdict", "license", "access",
          "patient_linkage", "temporal_validity", "care_setting", "modalities", "obligations",
          "evidence", "reviewed_on", "updated_at"
        ],
        "properties": {
          "dataset_id": { "type": "string", "pattern": "^DS-[0-9]{4}$" },
          "name": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "owner": { "type": "string", "description": "Team member accountable for this record" },
          "verdict": {
            "enum": ["UNDER_REVIEW", "ACCEPTED", "CONDITIONAL", "REJECTED"],
            "description": "ACCEPTED requires every dimension resolved with evidence. CONDITIONAL states the unmet condition explicitly."
          },
          "verdict_rationale": { "type": ["string", "null"] },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "redistribution_permitted", "derivatives_permitted", "status"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "redistribution_permitted": { "enum": ["YES", "NO", "CONDITIONAL", "UNKNOWN"] },
              "derivatives_permitted": { "enum": ["YES", "NO", "CONDITIONAL", "UNKNOWN"] },
              "open_weight_release_compatible": { "enum": ["YES", "NO", "CONDITIONAL", "UNKNOWN"] },
              "status": { "enum": ["VERIFIED", "UNVERIFIED"] },
              "notes": { "type": ["string", "null"] }
            }
          },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism", "credentialing_required", "citi_required", "status"],
            "properties": {
              "mechanism": { "type": "string" },
              "credentialing_required": { "type": "boolean" },
              "citi_required": { "type": "boolean", "description": "True when the provider requires CITI training; couples this record to TASK-0011" },
              "granted": { "enum": ["YES", "NO", "PENDING", "NOT_REQUESTED"] },
              "status": { "enum": ["VERIFIED", "UNVERIFIED"] },
              "notes": { "type": ["string", "null"] }
            }
          },
          "patient_linkage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stable_patient_identifier", "linkable_across_modalities", "status"],
            "properties": {
              "stable_patient_identifier": { "enum": ["YES", "NO", "UNKNOWN"] },
              "linkable_across_modalities": { "enum": ["YES", "NO", "PARTIAL", "UNKNOWN"] },
              "linkable_with": { "type": "array", "items": { "type": "string" } },
              "status": { "enum": ["VERIFIED", "UNVERIFIED"] },
              "notes": { "type": ["string", "null"] }
            }
          },
          "temporal_validity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["available_at_time_present", "status"],
            "properties": {
              "available_at_time_present": { "enum": ["YES", "NO", "PARTIAL", "UNKNOWN"] },
              "derivation_if_absent": { "type": ["string", "null"], "description": "How available_at_time would be derived, if the source does not carry it" },
              "status": { "enum": ["VERIFIED", "UNVERIFIED"] },
              "notes": { "type": ["string", "null"] }
            }
          },
          "care_setting": {
            "type": "object",
            "additionalProperties": false,
            "description": "Where the data was collected. DATA_CONTRACT.md requires population, site and time period at manifest time; recording it at survey time stops a dataset being adopted for a care setting it does not cover. DEC-0016 fixes the evaluated setting as emergency-department first-contact triage, so `covers_evaluated_setting` is measured against that.",
            "required": ["setting", "population", "covers_evaluated_setting", "status"],
            "properties": {
              "setting": {
                "type": "string",
                "description": "The care setting the data was collected in, in the source's own terms. 'NOT_A_CARE_SETTING' for teaching files, challenge archives and question-answer benchmarks."
              },
              "population": { "type": "string" },
              "time_period": { "type": ["string", "null"] },
              "covers_evaluated_setting": {
                "enum": ["YES", "NO", "PARTIAL", "UNKNOWN"],
                "description": "Whether this dataset covers the setting fixed by DEC-0016. NO is a legitimate answer for an unlinked capability subset; it forbids using the dataset as journey evidence, not as capability evidence."
              },
              "status": { "enum": ["VERIFIED", "UNVERIFIED"] },
              "notes": { "type": ["string", "null"] }
            }
          },
          "modalities": {
            "type": "array",
            "items": { "enum": ["clinical_text", "image_2d", "volume_3d", "structured", "longitudinal"] }
          },
          "obligations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deletion_required", "use_restrictions"],
            "properties": {
              "deletion_required": { "enum": ["YES", "NO", "UNKNOWN"] },
              "use_restrictions": { "type": "array", "items": { "type": "string" } },
              "external_transfer_permitted": { "enum": ["YES", "NO", "UNKNOWN"] },
              "notes": { "type": ["string", "null"] }
            }
          },
          "evidence": {
            "type": "array",
            "description": "Sources consulted. An empty array is only valid while verdict is UNDER_REVIEW.",
            "items": { "type": "string" }
          },
          "blocking_risks": { "type": "array", "items": { "type": "string", "pattern": "^RISK-[0-9]{4}$" } },
          "reviewed_by": { "type": ["string", "null"] },
          "reviewed_on": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
