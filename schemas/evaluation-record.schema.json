{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/evaluation-record.schema.json",
  "title": "Evaluation Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "evaluations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evaluation_id", "version", "manifest_ids", "code_revision", "data_version", "split_version", "model_versions", "contract_versions", "task", "decision_time_policy", "primary_metrics", "secondary_metrics", "sample_sizes", "exclusions", "statistics_plan", "artifacts", "status", "deviations", "review_verdict"],
        "properties": {
          "evaluation_id": {"type": "string", "pattern": "^EVAL-[0-9]{4}$"},
          "version": {"type": "string", "minLength": 1},
          "manifest_ids": {"type": "array", "items": {"type": "string", "pattern": "^exp_[0-9]{4}$"}, "minItems": 1},
          "code_revision": {"type": "string", "minLength": 4},
          "data_version": {"type": "string", "minLength": 2},
          "split_version": {"type": "string", "minLength": 2},
          "model_versions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "contract_versions": {"type": "object"},
          "task": {"type": "string", "minLength": 2},
          "decision_time_policy": {"type": "string", "minLength": 5},
          "primary_metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "secondary_metrics": {"type": "array", "items": {"type": "string"}},
          "sample_sizes": {"type": "object"},
          "exclusions": {"type": "array", "items": {"type": "string"}},
          "statistics_plan": {"type": "string", "minLength": 10},
          "artifacts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "status": {"enum": ["planned", "running", "completed", "failed", "invalidated"]},
          "deviations": {"type": "array", "items": {"type": "string"}},
          "review_verdict": {"enum": ["NOT_REVIEWED", "PASS", "CONDITIONAL_PASS", "FAIL", "CRITICAL_FAIL"]}
        }
      }
    }
  }
}

