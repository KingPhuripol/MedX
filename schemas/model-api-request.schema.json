{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senior-project.local/schemas/model-api-request.schema.json",
  "title": "Model Gateway Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "journey_id", "decision_time", "task", "evidence", "missing_information", "requested_outputs", "authorization", "provider_constraints"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 6},
    "journey_id": {"type": "string", "minLength": 4},
    "decision_time": {"type": "string", "format": "date-time"},
    "task": {"enum": ["CLINICAL_FRONT_DOOR", "MEDICAL_CAPABILITY", "ARCHITECTURE_EVALUATION"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "event_type", "modality", "available_at_time", "data_classification", "payload_ref"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 3},
          "event_type": {"type": "string", "minLength": 2},
          "modality": {"enum": ["TEXT", "STRUCTURED", "IMAGE_2D", "IMAGE_3D", "SIGNAL", "REFERENCE"]},
          "available_at_time": {"type": "string", "format": "date-time"},
          "data_classification": {"enum": ["SYNTHETIC", "PUBLIC_LICENSED", "DEIDENTIFIED_APPROVED", "IDENTIFIABLE_OR_LINKABLE", "RESTRICTED_DERIVATIVE"]},
          "payload_ref": {"type": "string", "minLength": 3}
        }
      }
    },
    "missing_information": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requested_outputs": {"type": "array", "items": {"enum": ["URGENCY", "RED_FLAGS", "CARE_PATHWAYS", "NEXT_INFORMATION", "UNCERTAINTY", "GRAPH"]}, "minItems": 1, "uniqueItems": true},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["data_classification", "external_provider_allowed", "approval_id"],
      "properties": {
        "data_classification": {"enum": ["SYNTHETIC", "PUBLIC_LICENSED", "DEIDENTIFIED_APPROVED", "IDENTIFIABLE_OR_LINKABLE", "RESTRICTED_DERIVATIVE"]},
        "external_provider_allowed": {"type": "boolean"},
        "approval_id": {"type": ["string", "null"], "pattern": "^APR-[0-9]{4}$"}
      }
    },
    "provider_constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_ms", "max_output_tokens", "cost_class", "deterministic_preferred"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "cost_class": {"enum": ["FREE_LOCAL", "LOW", "APPROVED_PAID"]},
        "deterministic_preferred": {"type": "boolean"}
      }
    }
  }
}

