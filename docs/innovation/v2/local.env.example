# Example only. Put actual values into your own untracked environment.
FRONT_DOOR_AUTH_MODE=token
FRONT_DOOR_PRINCIPALS_FILE=/absolute/path/to/private/principals.json
FRONT_DOOR_DB=artifacts/v2/demo.sqlite3
FRONT_DOOR_ALLOW_EXTERNAL=true
FRONT_DOOR_V2_TRANSPORT=openai_compatible
FRONT_DOOR_V2_PROVIDER_URL=http://127.0.0.1:8080/v1
FRONT_DOOR_V2_MODEL=replace-with-served-model-id
FRONT_DOOR_V2_PROVIDER_TOKEN=
FRONT_DOOR_V2_LOCAL_FREE=true
FRONT_DOOR_V2_BUDGET_DB=artifacts/v2/budget.sqlite3
FRONT_DOOR_V2_PAID_BUDGET_USD=0
FRONT_DOOR_V2_CALL_RESERVATION_USD=0
FRONT_DOOR_V2_CAPABILITIES=["summary","conversation","design"]
FRONT_DOOR_V2_JSON_MODE=json_schema
FRONT_DOOR_V2_MAX_TOKENS=2048
# Enable only when a transcription endpoint is running:
# FRONT_DOOR_V2_SPEECH_URL=http://127.0.0.1:8081/v1
# FRONT_DOOR_V2_SPEECH_MODEL=replace-with-transcription-model-id
FRONT_DOOR_V2_DIFFERENTIAL=false
