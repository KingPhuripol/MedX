{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front-door",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "uvicorn", "innovation.api.app:app", "--port", "8137"],
      "port": 8137
    },
    {
      "name": "front-door-pilot",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "FRONT_DOOR_AUTH_MODE=none",
        "FRONT_DOOR_PROVIDER=mock",
        "FRONT_DOOR_ALLOW_EXTERNAL=false",
        "FRONT_DOOR_V2_TRANSPORT=gateway",
        "FRONT_DOOR_V2_PROVIDER_URL=",
        "FRONT_DOOR_V2_SPEECH_URL=",
        "FRONT_DOOR_V2_SYNTHESIS_URL=",
        "FRONT_DOOR_DB=artifacts/pilot/pilot.sqlite3",
        "python3", "-m", "uvicorn", "innovation.api.app:app", "--host", "127.0.0.1", "--port", "8138"
      ],
      "port": 8138
    }
  ]
}
