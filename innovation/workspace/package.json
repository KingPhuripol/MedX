    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource/prompt": "5.2.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
