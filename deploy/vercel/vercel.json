{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/app/**,casegraph/**,data/synthetic/v1/**}",
      "excludeFiles": "{node_modules/**,.next/**,app/**,components/**,lib/**,public/**,**/__pycache__/**,**/tests/**}"
    }
  }
}
