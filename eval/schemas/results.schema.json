{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "s8 evaluation results (results.json). Research prototype - not for clinical use.",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "split", "split_version", "dataset", "frozen", "stamp",
               "manifest_sha256", "predictions_sha256", "comparator_sha256", "bootstrap", "environment",
               "labels", "expert_review", "n_patients", "n_decision_points", "frozen_entry_hash", "split_coverage",
               "rows"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.1"]},
    "frozen_entry_hash": {"type": ["string", "null"]},
    "split_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task", "population", "n_listed", "n_predicted", "n_missing", "missing_policy",
                     "n_imputed_abstain_decision_points", "imputation_unit", "arms"],
        "properties": {
          "task": {"type": "string"},
          "population": {"type": ["string", "null"]},
          "n_listed": {"type": ["integer", "null"], "minimum": 0},
          "n_predicted": {"type": "integer", "minimum": 0},
          "n_missing": {"type": ["integer", "null"], "minimum": 0},
          "missing_policy": {"type": "string", "enum": ["complete", "counted_as_abstain", "not_checked"]},
          "n_imputed_abstain_decision_points": {"type": "integer", "minimum": 0},
          "imputation_unit": {"type": "string", "enum": ["1 decision point per missing patient"]},
          "reason": {"type": "string"},
          "arms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["arm", "status", "n_predicted", "n_missing", "n_imputed_abstain_decision_points"],
              "properties": {
                "arm": {"type": "string"},
                "status": {"type": "string", "enum": ["provided", "not provided"]},
                "n_predicted": {"type": "integer", "minimum": 0},
                "n_missing": {"type": ["integer", "null"], "minimum": 0},
                "n_imputed_abstain_decision_points": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "evaluation_id": {"type": "string"},
    "split": {"type": "string", "enum": ["train", "dev", "test"]},
    "frozen": {"type": "boolean"},
    "stamp": {"type": ["string", "null"]},
    "manifest_sha256": {"type": "string", "minLength": 64},
    "predictions_sha256": {"type": "string", "minLength": 64},
    "comparator_sha256": {"type": ["string", "null"]},
    "bootstrap": {
      "type": "object",
      "required": ["n_boot", "seed", "ci_level", "method", "unit"],
      "properties": {"unit": {"type": "string", "enum": ["patient"]}}
    },
    "environment": {"type": "object", "required": ["numpy_version", "eval_version"]},
    "labels": {"type": "object", "required": ["banner", "research_prototype", "synthetic_data"]},
    "n_patients": {"type": "integer", "minimum": 0},
    "n_decision_points": {"type": "integer", "minimum": 0},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_id", "item", "task", "metric", "params", "primary", "point", "ci_low", "ci_high",
                     "ci_level", "n_boot", "seed", "method", "n_patients", "n_decision_points", "n_degenerate",
                     "unstable", "reason", "details", "comparisons", "thresholds"],
        "properties": {
          "point": {"type": ["number", "null"]},
          "ci_low": {"type": ["number", "null"]},
          "ci_high": {"type": ["number", "null"]},
          "ci_level": {"type": "number"},
          "n_boot": {"type": "integer", "minimum": 1},
          "seed": {"type": "integer"},
          "n_patients": {"type": "integer", "minimum": 0},
          "n_decision_points": {"type": "integer", "minimum": 0},
          "n_degenerate": {"type": ["integer", "null"]},
          "unstable": {"type": "boolean"},
          "reason": {"type": ["string", "null"]},
          "comparisons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["comparator", "status", "comparator_point", "diff"],
              "properties": {"status": {"type": "string", "enum": ["computed", "not provided"]}}
            }
          },
          "thresholds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["op", "value", "rule", "status"],
              "properties": {"status": {"type": "string", "enum": ["met", "not met", "undefined"]}}
            }
          }
        }
      }
    }
  }
}
