# Copy to .env for local dev (`make dev` loads it). .env is gitignored — never commit it.
# Everything here is DEV-ONLY and SYNTHETIC. Research prototype — not for clinical use.

# Database: unset => sqlite:///./backend/dev.db
# DATABASE_URL=postgresql+psycopg://frontdoor:frontdoor_dev_only@127.0.0.1:55432/frontdoor
DATABASE_URL=

# Model Gateway: mock is the default and the offline demo path.
GATEWAY_PROVIDER=mock
# External OpenAI-compatible adapter: disabled unless true; accepts data_class=synthetic only.
GATEWAY_EXTERNAL_ENABLED=false
EXTERNAL_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_MODEL=
GATEWAY_TIMEOUT_S=10

# Sessions
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false

# Dev-only synthetic seed users (nurse1, physician1, pharmacist1). Defaults if left empty:
#   nurse1-dev-only / physician1-dev-only / pharmacist1-dev-only
SEED_NURSE1_PASSWORD=
SEED_PHYSICIAN1_PASSWORD=
SEED_PHARMACIST1_PASSWORD=

# docker-compose PostgreSQL (dev/manual use only)
POSTGRES_PASSWORD=frontdoor_dev_only
